#ifndef VL53L0X_STM32_H
#define VL53L0X_STM32_H

#include "stm32f4xx_hal.h"
#include <stdbool.h>
#include <stdint.h>

#ifdef __cplusplus
extern "C" {
#endif

// Default I2C address (7-bit)
#define VL53L0X_ADDRESS_DEFAULT (0x29 << 1)

// Sensor handle structure
typedef struct {
    I2C_HandleTypeDef *i2c_handle;
    uint8_t address;
    uint16_t io_timeout;
    bool did_timeout;
    uint32_t timeout_start_ms;
    uint8_t stop_variable;
    uint32_t measurement_timing_budget_us;
} VL53L0X_Dev;

// Simple API functions
bool VL53L0X_Init(VL53L0X_Dev *dev, I2C_HandleTypeDef *hi2c, uint8_t address);
void VL53L0X_StartContinuous(VL53L0X_Dev *dev);
uint16_t VL53L0X_ReadRangeMM(VL53L0X_Dev *dev);
void VL53L0X_StopContinuous(VL53L0X_Dev *dev);
void VL53L0X_SetTimeout(VL53L0X_Dev *dev, uint16_t timeout_ms);
bool VL53L0X_TimeoutOccurred(VL53L0X_Dev *dev);

// Advanced functions (optional)
bool VL53L0X_SetSignalRateLimit(VL53L0X_Dev *dev, float limit_Mcps);
bool VL53L0X_SetMeasurementTimingBudget(VL53L0X_Dev *dev, uint32_t budget_us);

#ifdef __cplusplus
}
#endif

#endif // VL53L0X_STM32_H
