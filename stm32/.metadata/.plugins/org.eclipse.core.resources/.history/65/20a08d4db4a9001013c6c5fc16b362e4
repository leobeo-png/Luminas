/*******************************************************************************
 * VL53L0X Platform Implementation for STM32 HAL
 *
 * This file implements the platform-specific functions required by the
 * VL53L0X API for STM32 microcontrollers using HAL drivers.
 ******************************************************************************/

#include "vl53l0x_platform.h"
#include "vl53l0x_api.h"
#include "main.h"  // Includes stm32f4xx_hal.h and I2C handles

// External I2C handle - VL53L0X will use I2C2 (you can change to hi2c1 if needed)
extern I2C_HandleTypeDef hi2c2;

// I2C timeout in milliseconds
#define VL53L0X_I2C_TIMEOUT 100

/**
 * @brief  Writes multiple bytes to the device
 * @param  Dev: Device handle
 * @param  index: Register address
 * @param  pdata: Pointer to data buffer
 * @param  count: Number of bytes to write
 * @retval VL53L0X_Error status
 */
VL53L0X_Error VL53L0X_WriteMulti(VL53L0X_DEV Dev, uint8_t index, uint8_t *pdata, uint32_t count)
{
    HAL_StatusTypeDef status;

    status = HAL_I2C_Mem_Write(&hi2c2,
                                Dev->I2cDevAddr,
                                index,
                                I2C_MEMADD_SIZE_8BIT,
                                pdata,
                                count,
                                VL53L0X_I2C_TIMEOUT);

    if (status != HAL_OK) {
        return VL53L0X_ERROR_CONTROL_INTERFACE;
    }

    return VL53L0X_ERROR_NONE;
}

/**
 * @brief  Reads multiple bytes from the device
 * @param  Dev: Device handle
 * @param  index: Register address
 * @param  pdata: Pointer to data buffer
 * @param  count: Number of bytes to read
 * @retval VL53L0X_Error status
 */
VL53L0X_Error VL53L0X_ReadMulti(VL53L0X_DEV Dev, uint8_t index, uint8_t *pdata, uint32_t count)
{
    HAL_StatusTypeDef status;

    status = HAL_I2C_Mem_Read(&hi2c2,
                               Dev->I2cDevAddr,
                               index,
                               I2C_MEMADD_SIZE_8BIT,
                               pdata,
                               count,
                               VL53L0X_I2C_TIMEOUT);

    if (status != HAL_OK) {
        return VL53L0X_ERROR_CONTROL_INTERFACE;
    }

    return VL53L0X_ERROR_NONE;
}

/**
 * @brief  Writes a single byte to the device
 * @param  Dev: Device handle
 * @param  index: Register address
 * @param  data: Byte to write
 * @retval VL53L0X_Error status
 */
VL53L0X_Error VL53L0X_WrByte(VL53L0X_DEV Dev, uint8_t index, uint8_t data)
{
    return VL53L0X_WriteMulti(Dev, index, &data, 1);
}

/**
 * @brief  Reads a single byte from the device
 * @param  Dev: Device handle
 * @param  index: Register address
 * @param  data: Pointer to store read byte
 * @retval VL53L0X_Error status
 */
VL53L0X_Error VL53L0X_RdByte(VL53L0X_DEV Dev, uint8_t index, uint8_t *data)
{
    return VL53L0X_ReadMulti(Dev, index, data, 1);
}

/**
 * @brief  Writes a 16-bit word to the device (Big Endian)
 * @param  Dev: Device handle
 * @param  index: Register address
 * @param  data: Word to write
 * @retval VL53L0X_Error status
 */
VL53L0X_Error VL53L0X_WrWord(VL53L0X_DEV Dev, uint8_t index, uint16_t data)
{
    uint8_t buffer[2];

    // VL53L0X uses Big Endian format
    buffer[0] = (data >> 8) & 0xFF;
    buffer[1] = data & 0xFF;

    return VL53L0X_WriteMulti(Dev, index, buffer, 2);
}

/**
 * @brief  Reads a 16-bit word from the device (Big Endian)
 * @param  Dev: Device handle
 * @param  index: Register address
 * @param  data: Pointer to store read word
 * @retval VL53L0X_Error status
 */
VL53L0X_Error VL53L0X_RdWord(VL53L0X_DEV Dev, uint8_t index, uint16_t *data)
{
    uint8_t buffer[2];
    VL53L0X_Error status;

    status = VL53L0X_ReadMulti(Dev, index, buffer, 2);

    if (status == VL53L0X_ERROR_NONE) {
        // VL53L0X uses Big Endian format
        *data = ((uint16_t)buffer[0] << 8) | buffer[1];
    }

    return status;
}

/**
 * @brief  Writes a 32-bit double word to the device (Big Endian)
 * @param  Dev: Device handle
 * @param  index: Register address
 * @param  data: Double word to write
 * @retval VL53L0X_Error status
 */
VL53L0X_Error VL53L0X_WrDWord(VL53L0X_DEV Dev, uint8_t index, uint32_t data)
{
    uint8_t buffer[4];

    // VL53L0X uses Big Endian format
    buffer[0] = (data >> 24) & 0xFF;
    buffer[1] = (data >> 16) & 0xFF;
    buffer[2] = (data >> 8) & 0xFF;
    buffer[3] = data & 0xFF;

    return VL53L0X_WriteMulti(Dev, index, buffer, 4);
}

/**
 * @brief  Reads a 32-bit double word from the device (Big Endian)
 * @param  Dev: Device handle
 * @param  index: Register address
 * @param  data: Pointer to store read double word
 * @retval VL53L0X_Error status
 */
VL53L0X_Error VL53L0X_RdDWord(VL53L0X_DEV Dev, uint8_t index, uint32_t *data)
{
    uint8_t buffer[4];
    VL53L0X_Error status;

    status = VL53L0X_ReadMulti(Dev, index, buffer, 4);

    if (status == VL53L0X_ERROR_NONE) {
        // VL53L0X uses Big Endian format
        *data = ((uint32_t)buffer[0] << 24) |
                ((uint32_t)buffer[1] << 16) |
                ((uint32_t)buffer[2] << 8) |
                buffer[3];
    }

    return status;
}

/**
 * @brief  Updates a byte by ANDing and ORing with masks
 * @param  Dev: Device handle
 * @param  index: Register address
 * @param  AndData: AND mask
 * @param  OrData: OR mask
 * @retval VL53L0X_Error status
 */
VL53L0X_Error VL53L0X_UpdateByte(VL53L0X_DEV Dev, uint8_t index, uint8_t AndData, uint8_t OrData)
{
    VL53L0X_Error status;
    uint8_t data;

    status = VL53L0X_RdByte(Dev, index, &data);

    if (status == VL53L0X_ERROR_NONE) {
        data = (data & AndData) | OrData;
        status = VL53L0X_WrByte(Dev, index, data);
    }

    return status;
}

/**
 * @brief  Polling delay implementation
 * @param  Dev: Device handle
 * @retval VL53L0X_Error status
 */
VL53L0X_Error VL53L0X_PollingDelay(VL53L0X_DEV Dev)
{
    HAL_Delay(1);  // 1ms delay
    return VL53L0X_ERROR_NONE;
}

